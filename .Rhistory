fvect=rep(0,q)
for(g in 1:q)
for (i in 1:n)
fvect[g]=fvect[g]+KRN(grid[g]-x[i])
plot(grid, fvect, type="l", ylim=c(min(fvect, -4.5), max(fvect)))
points(x, rep(-4,n), pch=20)
fvect_rect=rep(0,q)
for(g in 1:q)
for (i in 1:n)
fvect_rect[g]=fvect_rect[g]+rect_KRN(grid[g]-x[i])
plot(grid, fvect_rect, type="l", ylim=c(min(fvect_rect), max(fvect_rect, 2.5)))
points(x, rep(2,n), pch=20)
points(x, rep(1,n), pch=20)
